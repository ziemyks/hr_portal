# Server-only. Never expose these to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service_role key from credential supabase-blt-service-role>

# Shared portal password and cookie-signing secret (>= 32 chars: openssl rand -base64 48)
PORTAL_PASSWORD=<choose a password>
AUTH_SECRET=<random string>
